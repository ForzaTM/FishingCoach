# CurseForge / BigWigs packager config.
# The packager replaces @project-version@ in the TOC with the git tag.
package-as: ReelGold

ignore:
  - README.md
  - CHANGELOG.md
  - CLAUDE.md
  - docs
  - tools
  - .github
  - .gitignore
  - .editorconfig
  - .gitattributes
  - tests
  - package.json
  - package-lock.json
  - node_modules

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
